# =================================
# SQLTalk-AI Configuration Template
# =================================
# Copia este archivo como .env y completa con tus credenciales

# ==================
# DeepSeek Configuration (RECOMENDADO)
# ==================
# Obtén tu API key en: https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=tu_clave_deepseek_aqui

# URL base del API (solo cambiar si usas un proxy/openrouter)
# AI_MODEL_BASE_URL=https://api.deepseek.com/v1

# ==================
# OpenAI Configuration (FALLBACK)
# ==================
# Solo necesario si quieres usar OpenAI en lugar de DeepSeek
OPENAI_API_KEY=tu_clave_openai_aqui

# ==================
# SQL Server Configuration (OPCIONAL)
# ==================
# Solo necesario si quieres configuración automática
# Para autenticación Windows, deja estos campos vacíos
SERVER_NAME=localhost\SQLEXPRESS
DATABASE_NAME=master

# ==================
# PostgreSQL Configuration (OPCIONAL)
# ==================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_contraseña
POSTGRES_DATABASE=nombre_base_datos

# ==================
# MySQL Configuration (OPCIONAL)
# ==================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=tu_usuario
MYSQL_PASSWORD=tu_contraseña
MYSQL_DATABASE=nombre_base_datos

# ==================
# Application Settings
# ==================
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Archivo de log (opcional)
LOG_FILE=sqltalk.log

# Máximo número de filas para mostrar en resultados
MAX_ROWS_DISPLAY=1000

# ==================
# UI Configuration
# ==================
# Tema de Streamlit: light, dark
STREAMLIT_THEME=dark

# Título personalizado de la aplicación
APP_TITLE=SQLTalk-AI

# ==================
# AI Model Settings
# ==================
# Modelo exacto: deepseek-v4-flash, deepseek-v4-pro, gpt-4o-mini, etc.
AI_MODEL=deepseek-v4-flash

# URL base del API (DeepSeek, OpenAI, OpenRouter, etc.)
# DeepSeek: https://api.deepseek.com/v1
# OpenAI:  https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
AI_MODEL_BASE_URL=https://api.deepseek.com/v1

# Temperatura del modelo (0.0 = preciso/determinístico, 1.0 = creativo)
AI_TEMPERATURE=0.0

# Máximo de tokens para respuestas
MAX_TOKENS=2000

# ==================
# Database Connection Settings
# ==================
# Timeout de conexión en segundos
CONNECTION_TIMEOUT=30

# Máximo número de filas a retornar por consulta
MAX_QUERY_ROWS=10000

# ==================
# Security Settings
# ==================
# Habilitar validación de consultas SQL (recomendado)
ENABLE_SQL_VALIDATION=true

# Palabras prohibidas en consultas (separadas por coma)
FORBIDDEN_SQL_KEYWORDS=DROP,DELETE,TRUNCATE,ALTER,CREATE,INSERT,UPDATE

# ==================
# Performance Settings
# ==================
# Cache de resultados en segundos (0 = deshabilitado)
CACHE_TTL=300

# Máximo tamaño de cache en MB
MAX_CACHE_SIZE=100